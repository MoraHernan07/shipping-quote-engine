{
  "name": "shipping-quote-engine",
  "version": "0.1.0",
  "description": "Shipping quote engine for e-commerce: box selection, billable weight, carrier rate shopping and margin-protected shipping subsidies. Integer money, pure functions, property-tested.",
  "license": "MIT",
  "author": "Luis Morales Hernandez",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "demo": "tsx examples/quote.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run playground:build",
    "playground": "vite --config playground/vite.config.mts",
    "playground:build": "vite build --config playground/vite.config.mts"
  },
  "keywords": [
    "shipping",
    "logistics",
    "bin-packing",
    "e-commerce",
    "typescript",
    "property-based-testing"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
